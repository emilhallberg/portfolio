# Server-only SMTP settings. Copy to .env.local for Vercel CLI development.
# Set these in Vercel for Preview and Production; never prefix with REACT_APP_.
EMAIL_HOST=smtp.mail.me.com
EMAIL_PORT=587
# Authenticate with the full iCloud Mail address for the account owning the domain.
EMAIL_USERNAME=yourname@icloud.com
# Generate an Apple app-specific password named Portfolio Vercel.
EMAIL_PASSWORD=
# Sender and recipient can differ from the SMTP authentication address.
EMAIL_FROM=emil@hallbergemil.com
EMAIL_TO=emil@hallbergemil.com

# Only for `vercel dev`; `yarn start` defaults to the legacy server on port 4000.
# REACT_APP_CONTACT_API_URL=/api
