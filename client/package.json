{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "vite --host 127.0.0.1 --port 3005 --strictPort",
    "lint": "eslint --max-warnings 0 src",
    "test:api": "node --test tests/email.test.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "all"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "i18next": "^27.1.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "i18next-http-backend": "^4.0.10",
    "nodemailer": "^10.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router": "^6.30.3",
    "react-router-dom": "^6.30.3",
    "styled-components": "^5.3.11",
    "react-is": "^19.3.1"
  },
  "devDependencies": {
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^2.7.1",
    "vite": "^8.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "@types/react": "^19.3.0",
    "@types/styled-components": "^5.1.36",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "@eslint/js": "^10.0.1",
    "globals": "^16.5.0"
  },
  "engines": {
    "node": "22.x"
  },
  "resolutions": {
    "@types/react": "^19.3.0"
  }
}
